# Sebetsa — environment configuration template.
#
# Copy this file to `.env.local` (gitignored — never commit real values).
# Vite exposes only variables prefixed `VITE_` to the browser bundle; the
# typed list the app reads is in src/vite-env.d.ts.
#
# NEVER put a `service_role` key in this file or under a VITE_ name: it would
# ship to every browser that loads the app and bypass row-level security.
# Only the public anon key belongs here — RLS (supabase/migrations/) is what
# actually restricts access.

# Required — Supabase project API URL.
#   Local:  printed by `supabase start` (this repo's supabase/config.toml uses
#           port 55321, i.e. http://127.0.0.1:55321).
#   Hosted: Project Settings → API → Project URL (https://<project-ref>.supabase.co).
VITE_SUPABASE_URL=http://127.0.0.1:55321

# Required — Supabase anon/public API key (local: printed by `supabase start`;
# hosted: Project Settings → API). Safe to expose to the browser.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — product name shown in the UI shell.
VITE_APP_NAME=Sebetsa

# Optional — HTTPS endpoint that receives scrubbed client error reports (message, stack, route path,
# version only — never tokens, passwords, emails or form data). Unset = errors are only logged locally.
# VITE_ERROR_REPORT_URL=https://errors.example.com/report
# VITE_APP_VERSION=

# ------------------------------------------------------------------------
# Local demo data
#
# `supabase db reset` applies supabase/migrations/*.sql and then
# supabase/seed.sql (a small deterministic demo organisation with no real
# people or credentials). Never point the app at a hosted project with
# demo data loaded.

# ------------------------------------------------------------------------
# Notification delivery worker (Edge Function `notifications-dispatch`).
#
# These are Edge Function SECRETS, not VITE_ variables: they are never in the
# browser bundle and never in git. Set them for the deployment with
#   supabase secrets set NAME=value
# or export them locally before `supabase functions serve`. The worker does
# nothing until it is deployed AND scheduled AND a channel's secrets are set;
# until then in-app notifications are unaffected and external deliveries stay
# `pending`. Full details: docs/NOTIFICATIONS_DELIVERY.md.
#
#   Always:    NOTIFICATIONS_DISPATCH_SECRET   (shared secret, x-dispatch-secret header)
#   Always:    OPS_HEALTH_SECRET               (ops-health Edge Function: reveals alert detail when sent as x-health-secret)
#   Email:     RESEND_API_KEY, RESEND_FROM     (RESEND_FROM = a verified sender you control)
#   SMS:       TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_SMS_FROM
#   WhatsApp:  TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions
# by the platform; do not set them yourself and never expose the latter.

# ------------------------------------------------------------------------
# Checks (none of these need real credentials)
#
#   npm ci                      install dependencies
#   npm run dev                 Vite dev server (needs the two variables above)
#   npm run typecheck           tsc -b --noEmit
#   npm run lint                eslint .
#   npm run test                vitest — pure unit tests
#   npm run build               typecheck + production build
#   npm run test:e2e            Playwright against an in-memory fake backend
#                               (e2e/utils/fakeBackend.ts); any request that is
#                               not modelled, or that leaves localhost, fails
#                               the test. The dev server only needs the two
#                               variables to be non-empty.
#   bash supabase/rls-tests/run.sh
#                               applies every migration to a throwaway Postgres
#                               and runs every RLS/trigger/SECURITY DEFINER
#                               suite. Needs Docker, or RLS_DATABASE_URL pointing
#                               at an empty disposable server (never a hosted
#                               project — the script refuses those URLs).
#   bash scripts/generate-db-types.sh [--check]
#                               regenerates src/lib/database.types.ts and
#                               e2e/utils/schemaDefaults.ts from the migrations
#                               (needs RLS_DATABASE_URL as above).
