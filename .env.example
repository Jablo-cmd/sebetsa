# Sebetsa environment configuration template.
#
# Copy to .env.local (gitignored) and set these values. Never commit real
# credentials. Vite exposes VITE_* values to browser code, so only use the
# Supabase anon/public key here. Never put a service_role key in VITE_*.
#
# For local development, run `supabase start` and use the API URL and anon
# key it prints. `supabase db reset` applies migrations and the local seed.
#
# Required: Supabase project API URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
#
# Required: Supabase anon/public key. Database RLS and server-side policies
# must enforce access control; this key is not a secret.
VITE_SUPABASE_ANON_KEY=your-anon-key
#
# Optional: display name shown in the application shell.
VITE_APP_NAME=Sebetsa

# Notification delivery (Edge Function secrets; never VITE_* and never commit
# values). Configure with `supabase secrets set NAME=value` only if enabling
# external email/SMS/WhatsApp delivery. Without these, notifications remain
# in-app.
# NOTIFICATIONS_DISPATCH_SECRET=
# RESEND_API_KEY=
# RESEND_FROM=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=

# Build and test:
# npm install
# npm run dev
# npm run build
# npm run typecheck
# npm run lint
# npm run test
# npm run test:e2e
# supabase/rls-tests/run.sh (requires Docker)
